# Caddy gets and renews the HTTPS certificate for {$DOMAIN} automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Python for the browser lab rarely changes: let browsers cache it for a week
	@pyodide path /pyodide/*
	header @pyodide Cache-Control "public, max-age=604800"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

# Redirect www to the bare domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
