# Copy to .env on the server and fill in. Never commit .env.

# --- Required ---
DOMAIN=akadalabs.org
# A long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The first team account, created on first start. Change the password after signing in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI for the interactive labs (weeks 7-10). The key stays on the server. ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Allowed models, comma separated; the first is the default
AI_MODELS=llama-3.1-8b-instant
# Calls per learner per day (Lagos time), all calls per day, and the longest reply allowed
AI_DAILY_LIMIT=100
AI_DAILY_BUDGET=3000
AI_MAX_TOKENS=512

# Embeddings (weeks 8-9). Groq has none; Gemini's OpenAI-compatible API works:
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBED_MODEL=gemini-embedding-001
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# --- Email (optional). Without it, the team shares learner links by hand. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Akada Labs <hello@akadalabs.org>"

# --- Error tracking (optional) ---
SENTRY_DSN=
